#!/usr/bin/env python3
"""Scan intended or actual paths and executable command invocations."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from workflow.enforcement.core import append_log, scan  # noqa: E402

parser = argparse.ArgumentParser()
parser.add_argument("--intended-path", action="append", default=[])
parser.add_argument("--actual-path", action="append", default=[])
parser.add_argument("--command")
parser.add_argument("--policy", type=Path)
parser.add_argument("--log-root", type=Path)
args = parser.parse_args()
try:
    result = scan([*args.intended_path, *args.actual_path], args.command, args.policy) if args.policy else scan([*args.intended_path, *args.actual_path], args.command)
    if args.log_root:
        for item in result["triggers"]:
            append_log(args.log_root, f"L{item['minimum_level']}", f"trigger: {item['id']}({item['evidence']})")
    print(json.dumps(result, sort_keys=True))
except Exception as error:
    print(json.dumps({"error": str(error)}), file=sys.stderr)
    raise SystemExit(1)
