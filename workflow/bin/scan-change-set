#!/usr/bin/env python3
"""Authoritative actual-change-set scanner; also records mechanical activations."""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from workflow.enforcement.core import append_log, scan  # noqa: E402

parser = argparse.ArgumentParser()
parser.add_argument("--platform", default="unknown")
args = parser.parse_args()

root = Path.cwd()

def git_paths(arguments: list[str]) -> list[str]:
    result = subprocess.run(["git", *arguments], cwd=root, capture_output=True, text=True, check=True)
    return result.stdout.splitlines()

def head_paths() -> list[str]:
    # Fresh repositories have no HEAD, so diff against the empty tree instead.
    probe = subprocess.run(["git", "rev-parse", "--verify", "HEAD"], cwd=root, capture_output=True, text=True)
    return git_paths(["diff", "--name-only", "HEAD"]) if probe.returncode == 0 else git_paths(["diff", "--name-only", "--cached"])

# `git diff HEAD` misses untracked files; all three sources are needed for an
# authoritative working-tree change set.
changed = sorted(set(head_paths()
                     + git_paths(["diff", "--name-only", "--cached"])
                     + git_paths(["ls-files", "--others", "--exclude-standard"])
                     + git_paths(["ls-files", "--others", "--ignored", "--exclude-standard"])))
result = scan(changed)
for item in result["triggers"]:
    append_log(root, f"L{item['minimum_level']}", f"trigger: {item['id']}({item['evidence']})", platform=args.platform)
print(json.dumps(result, sort_keys=True))
